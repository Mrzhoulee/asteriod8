{
  "rules": {
    "CONCERT_SCHEDULE": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$showId": {
        ".validate": "newData.hasChildren(['room','artist','startsAt','endsAt']) && newData.child('room').isString() && newData.child('room').val().matches(/^Room[1-5]$/) && newData.child('artist').isString() && newData.child('artist').val().length <= 80 && newData.child('startsAt').isNumber() && newData.child('endsAt').isNumber() && newData.child('endsAt').val() > newData.child('startsAt').val()"
      }
    },
    "CONCERT_CONFIG": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'console.admin@asteroid8.net'"
    },
    "CONCERT_PRESENCE": {
      ".read": true,
      "$room": {
        "$viewer": {
          ".write": true,
          ".validate": "$room.matches(/^Room[1-5]$/) && $viewer.length <= 200 && newData.isNumber()"
        }
      }
    },
    "FAN_SURVEY": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$key": {
        ".write": "($key.beginsWith('a_') && $key.length <= 40) || (auth != null && auth.token.email != null && $key == auth.token.email.toLowerCase().replace('.', '_'))",
        ".validate": "newData.hasChildren(['role','ts']) && (newData.child('role').val() == 'fan' || newData.child('role').val() == 'artist') && newData.child('ts').isNumber() && (!newData.hasChild('other') || (newData.child('other').isString() && newData.child('other').val().length <= 120))"
      }
    },
    "REWARDS": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      ".write": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "attendance": {
        "$uk": {
          ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
          "$showId": {
            ".write": "!data.exists() && auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
            ".validate": "newData.hasChildren(['ts']) && newData.child('ts').val() == now && root.child('CONCERT_SCHEDULE').child($showId).child('startsAt').val() <= now + 1800000 && root.child('CONCERT_SCHEDULE').child($showId).child('endsAt').val() >= now"
          }
        }
      },
      "tips": {
        "$uk": {
          ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
          "$tipId": {
            ".validate": "newData.hasChildren(['amountCents','artist','ts']) && newData.child('amountCents').isNumber() && newData.child('amountCents').val() > 0 && newData.child('artist').isString() && newData.child('ts').isNumber()"
          }
        }
      },
      "adjust": {
        "$uk": {
          ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
          "$adjId": {
            ".validate": "newData.hasChildren(['points','ts']) && newData.child('points').isNumber() && newData.child('ts').isNumber()"
          }
        }
      },
      "redemptions": {
        "$uk": {
          ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
          "$reqId": {
            ".write": "!data.exists() && newData.child('status').val() == 'pending' && auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
            ".validate": "newData.hasChildren(['type','points','ts','status']) && newData.child('type').isString() && newData.child('type').val().matches(/^(giftcard|tip|shoutout|badge|early)$/) && newData.child('points').isNumber() && newData.child('points').val() > 0 && newData.child('points').val() <= 1000000 && newData.child('ts').isNumber() && newData.child('status').isString() && newData.child('status').val().matches(/^(pending|sent|rejected)$/) && (!newData.hasChild('email') || (newData.child('email').isString() && newData.child('email').val().length <= 200)) && (!newData.hasChild('detail') || (newData.child('detail').isString() && newData.child('detail').val().length <= 300)) && (!newData.hasChild('card') || (newData.child('card').isString() && newData.child('card').val().length <= 40))"
          }
        }
      },
      "referrals": {
        "$code": {
          ".read": "auth != null && auth.token.email != null && root.child('CONCERT_REF_CODES').child($code).child('uk').val() == auth.token.email.toLowerCase().replace('.', '_')",
          "$friend": {
            ".write": "!data.exists() && auth != null && auth.token.email != null && $friend == auth.token.email.toLowerCase().replace('.', '_')",
            ".validate": "newData.hasChildren(['ts','showId']) && newData.child('ts').val() == now && newData.child('showId').isString() && root.child('CONCERT_REF_CODES').child($code).exists() && root.child('CONCERT_REF_CODES').child($code).child('uk').val() != $friend && root.child('REWARDS').child('attendance').child($friend).child(newData.child('showId').val()).exists() && newData.parent().parent().parent().child('referred').child($friend).child('code').val() == $code"
          }
        }
      },
      "referred": {
        "$uk": {
          ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
          ".write": "!data.exists() && auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
          ".validate": "newData.hasChildren(['code','ts']) && newData.child('ts').val() == now && newData.child('code').isString() && newData.parent().parent().child('referrals').child(newData.child('code').val()).child($uk).exists()"
        }
      }
    },
    "CONCERT_SHOUTOUTS": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'console.admin@asteroid8.net'"
    },
    "FAN_OPTIN": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      ".write": "auth != null && auth.token.email == 'console.admin@asteroid8.net'"
    },
    "STRIPE_ORDERS": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      ".write": "auth != null && auth.token.email == 'console.admin@asteroid8.net'"
    },
    "CONCERT_REF_CODES": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$code": {
        ".write": "!data.exists() && auth != null && auth.token.email != null && newData.child('uk').val() == auth.token.email.toLowerCase().replace('.', '_')",
        ".validate": "$code.matches(/^[a-z0-9]{6,12}$/) && newData.hasChildren(['uk','ts']) && newData.child('ts').isNumber() && newData.parent().parent().child('CONCERT_REF_BY_USER').child(newData.child('uk').val()).val() == $code"
      }
    },
    "CONCERT_REF_BY_USER": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$uk": {
        ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
        ".write": "!data.exists() && auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
        ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{6,12}$/) && newData.parent().parent().child('CONCERT_REF_CODES').child(newData.val()).child('uk').val() == $uk"
      }
    },
    "CONCERT_PASSES": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$showId": {
        "$uk": {
          ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
          ".write": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_') && (!data.exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['ts','email']) && root.child('CONCERT_SCHEDULE').child($showId).child('endsAt').val() > now",
          "ts": { ".validate": "newData.val() == now" },
          "email": { ".validate": "newData.isString() && newData.val() == auth.token.email" },
          "via": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,40}$/)" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "tz": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other": { ".validate": false }
        }
      }
    },
    "CONCERT_PASS_MAIL": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      ".write": "auth != null && auth.token.email == 'console.admin@asteroid8.net'"
    },
    "ARTIST_APPLICATIONS": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$uk": {
        ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
        ".write": "(auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')) || (auth != null && auth.token.email == 'console.admin@asteroid8.net' && !newData.exists())",
        ".validate": "newData.hasChildren(['ts','email','name','ig','genre','perform'])",
        "ts": { ".validate": "newData.val() == now" },
        "email": { ".validate": "newData.isString() && newData.val() == auth.token.email" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "ig": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._]{1,30}$/)" },
        "genre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "perform": { ".validate": "newData.isString() && newData.val().matches(/^(live|dj|both)$/)" },
        "link": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 300" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "via": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,40}$/)" },
        "$other": { ".validate": false }
      }
    },
    "BACKSTAGE": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$uk": {
        ".read": "auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_')",
        ".write": "(auth != null && auth.token.email != null && $uk == auth.token.email.toLowerCase().replace('.', '_') && !data.exists()) || (auth != null && auth.token.email == 'console.admin@asteroid8.net')",
        ".validate": "newData.hasChildren(['code','ts','email','role']) && newData.child('code').isString() && newData.child('code').val().matches(/^AST[A-Z0-9]{5}$/) && newData.parent().parent().child('BACKSTAGE_CODES').child(newData.child('code').val()).child('uk').val() == $uk && (auth.token.email == 'console.admin@asteroid8.net' || (newData.child('email').val() == auth.token.email && !newData.hasChild('verifiedAt') && !newData.hasChild('ig')))",
        "code": { ".validate": "newData.isString()" },
        "ts": { ".validate": "newData.isNumber()" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "role": { ".validate": "newData.isString() && newData.val().matches(/^(fan|artist)$/)" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "via": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,40}$/)" },
        "verifiedAt": { ".validate": "newData.isNumber()" },
        "ig": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._]{1,30}$/)" },
        "$other": { ".validate": false }
      }
    },
    "BACKSTAGE_CODES": {
      ".read": "auth != null && auth.token.email == 'console.admin@asteroid8.net'",
      "$code": {
        ".write": "(!data.exists() && auth != null && auth.token.email != null && newData.child('uk').val() == auth.token.email.toLowerCase().replace('.', '_')) || (auth != null && auth.token.email == 'console.admin@asteroid8.net' && !newData.exists())",
        ".validate": "$code.matches(/^AST[A-Z0-9]{5}$/) && newData.hasChildren(['uk','ts']) && newData.child('ts').isNumber() && newData.parent().parent().child('BACKSTAGE').child(newData.child('uk').val()).child('code').val() == $code"
      }
    }
  }
}
